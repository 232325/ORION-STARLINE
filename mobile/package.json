{
  "name": "orion-starline-mobile",
  "version": "1.0.0",
  "description": "Orion Starline AI Trading Platform Mobile App - iOS va Android uchun React Native ilovasi",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android": "expo build:android",
    "build:ios": "expo build:ios",
    "build:web": "expo build:web",
    "publish": "expo publish",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "type-check": "tsc --noEmit",
    "clean": "expo r -c",
    "doctor": "expo doctor",
    "install:dependencies": "npm install",
    "generate:apk": "cd android && ./gradlew assembleRelease",
    "generate:ipa": "cd ios && xcodebuild -workspace OrionStarline.xcworkspace -scheme OrionStarline archive -archivePath OrionStarline.xcarchive"
  },
  "keywords": [
    "trading",
    "ai",
    "forex",
    "mobile",
    "react-native",
    "expo",
    "ios",
    "android",
    "fintech"
  ],
  "author": {
    "name": "Orion Starline AI Trading System",
    "email": "support@orion-starline.com",
    "url": "https://orion-starline.com"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "react": "18.0.0",
    "react-native": "0.72.6",
    "expo": "~49.0.15",
    "expo-status-bar": "~1.6.0",
    "expo-linear-gradient": "~12.3.0",
    "expo-font": "~11.4.0",
    "expo-notifications": "~0.20.1",
    "expo-local-authentication": "~13.4.0",
    "expo-secure-store": "~12.3.0",
    "expo-location": "~16.1.0",
    "expo-camera": "~13.4.4",
    "expo-image-picker": "~14.3.2",
    "expo-media-library": "~15.4.1",
    "expo-file-system": "~15.4.5",
    "expo-sharing": "~11.5.0",
    "expo-print": "~12.4.0",
    "expo-intent-launcher": "~10.5.0",
    "expo-web-browser": "~12.3.0",
    "expo-barcode-scanner": "~12.5.3",
    "expo-sensors": "~12.3.0",
    "expo-av": "~13.4.1",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/stack": "^6.3.17",
    "@react-navigation/drawer": "^6.6.3",
    "@react-native-async-storage/async-storage": "1.18.2",
    "@react-native-community/netinfo": "9.3.10",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "react-native-vector-icons": "^10.0.0",
    "react-native-webview": "13.2.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-camera": "^4.2.1",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-device-info": "^10.11.0",
    "react-native-keep-awake": "^4.0.0",
    "react-native-orientation-locker": "^1.7.0",
    "react-native-screens": "~3.22.0",
    "react-native-safe-area-context": "4.6.3",
    "react-native-gesture-handler": "~2.12.0",
    "react-native-reanimated": "~3.3.0",
    "react-native-paper": "^5.10.0",
    "react-native-elements": "^3.4.3",
    "react-native-elements-bottom-sheet": "^0.2.0",
    "react-native-modal": "^13.0.1",
    "react-native-modalbox": "^2.0.2",
    "react-native-swiper-flatlist": "^3.2.3",
    "react-native-skeleton-placeholder": "^5.2.4",
    "react-native-progress": "^5.0.1",
    "react-native-countdown-component": "^2.7.1",
    "react-native-qrcode-scanner": "^1.5.5",
    "react-native-qrcode-generator": "^1.3.11",
    "react-native-textinput-mask": "^2.0.1",
    "react-native-searchable-dropdown": "^1.1.3",
    "react-native-grid-view": "^0.4.1",
    "react-native-swipeout": "^2.3.6",
    "react-native-parallax-scroll-view": "^0.4.2",
    "react-native-tab-view": "^3.5.2",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-super-grid": "^4.9.11",
    "react-native-material-menu": "^2.0.0",
    "react-native-dropdown-picker": "^6.0.5",
    "react-native-picker-select": "^8.1.0",
    "react-native-color-picker": "^0.6.0",
    "react-native-slider": "^0.11.0",
    "react-native-switch-toggle": "^2.2.1",
    "react-native-segmented-control-tab": "^4.0.0",
    "react-native-step-indicator": "^1.0.3",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-svg": "13.9.0",
    "react-native-calendars": "^1.1302.0",
    "react-native-wheel-picker-android": "^2.0.9",
    "react-native-date-picker": "^4.2.14",
    "react-native-datepicker": "^1.7.2",
    "react-native-form-validator": "^2.0.1",
    "react-native-validation": "^1.0.2",
    "react-native-masked-text": "^1.16.0",
    "react-native-credit-card-input": "^0.4.1",
    "react-native-floating-action": "^1.22.0",
    "react-native-search-bar": "^3.5.0",
    "react-native-search-filter": "^0.1.5",
    "react-native-auto-scroll": "^1.0.1",
    "react-native-auto-scrolling": "^1.0.0",
    "react-native-fast-image": "^8.6.3",
    "react-native-image-crop-picker": "^0.40.2",
    "react-native-image-resizer": "^3.0.7",
    "react-native-photo-view": "^1.5.4",
    "react-native-photo-view-custom": "^1.0.0",
    "react-native-video": "^5.2.1",
    "react-native-youtube": "^2.0.2",
    "react-native-youtube-iframe": "^2.2.2",
    "react-native-video-controls": "^2.7.0",
    "react-native-fullscreen-video": "^0.0.2",
    "react-native-audio-recorder-player": "^3.6.1",
    "react-native-sound": "^0.11.2",
    "react-native-music-control": "^1.4.0",
    "react-native-siri-shortcuts": "^3.1.3",
    "react-native-widget": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~18.2.14",
    "@types/react-native": "~0.72.2",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-preset-expo": "^10.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.30.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.0.0",
    "jest": "^29.2.1",
    "jest-expo": "^49.0.0",
    "prettier": "^2.4.1",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.1.3",
    "expo-updates": "~0.18.19"
  },
  "resolutions": {
    "react-native-svg": "13.9.0"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setupTests.js"
    ]
  },
  "eslintConfig": {
    "extends": [
      "expo",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended"
    ],
    "plugins": [
      "react",
      "react-hooks"
    ],
    "rules": {
      "react/prop-types": "off",
      "@typescript-eslint/no-unused-vars": "error",
      "react-hooks/rules-of-hooks": "error"
    },
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      },
      "ecmaVersion": 2018,
      "sourceType": "module"
    },
    "env": {
      "es6": true,
      "node": true,
      "react-native/react-native": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/orion-starline/mobile-app.git"
  },
  "bugs": {
    "url": "https://github.com/orion-starline/mobile-app/issues"
  },
  "homepage": "https://orion-starline.com/mobile",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "expo": {
    "name": "Orion Starline",
    "slug": "orion-starline-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e3a8a"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.orionstarline.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID yordamida ilovaga xavfsiz kirish uchun",
        "NSLocationWhenInUseUsageDescription": "Joylashuv ma'lumotlari trading aktivlari uchun ishlatiladi",
        "NSMicrophoneUsageDescription": "Audio ma'lumotlar qayta ishlash uchun",
        "NSCameraUsageDescription": "QR kod skanerlash va hujjat skanerlash uchun",
        "NSPhotoLibraryUsageDescription": "Screenshot va hujjat yuklash uchun",
        "NSUserTrackingUsageDescription": "Personalizatsiya va analytics uchun"
      },
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx",
        "googleMobileAdsAutoInit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e3a8a"
      },
      "package": "com.orionstarline.mobile",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED",
        "FOREGROUND_SERVICE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_WAP_PUSH_MESSAGES"
      ],
      "config": {
        "googleMobileAdsAppId": "ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx",
        "googleMobileAdsAutoInit": true
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ijro etish uchun joylashuv ruxsati kerak."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1e3a8a"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera ruxsati hujjat skanerlash uchun kerak."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Rasm va video ruxsati saqlash uchun kerak."
        }
      ]
    ],
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/your-project-id"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      },
      "apiUrl": "https://api.orion-starline.com",
      "wsUrl": "wss://ws.orion-starline.com",
      "environment": "production"
    }
  }
}