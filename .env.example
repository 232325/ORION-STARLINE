# ========================================
# ORION STARLINE ENVIRONMENT VARIABLES
# ========================================

# ========================================
# SUPABASE CONFIGURATION
# ========================================
# Supabase Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (public)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ========================================
# DATABASE CONFIGURATION
# ========================================
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/orion_starline

# Redis URL for caching
REDIS_URL=redis://localhost:6379

# ========================================
# AUTHENTICATION & SECURITY
# ========================================
# JWT Secret Key
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this

# Access Token Expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh Token Expiration (days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# ========================================
# API KEYS & INTEGRATIONS
# ========================================
# OpenAI API Key for AI Assistant
OPENAI_API_KEY=your-openai-api-key

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Trading Platform API Keys
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET_KEY=your-binance-secret-key

# Market Data APIs
COINMARKETCAP_API_KEY=your-coinmarketcap-api-key
ALPHAVANTAGE_API_KEY=your-alphavantage-api-key

# ========================================
# EMAIL CONFIGURATION
# ========================================
# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Email Templates
FROM_EMAIL=noreply@orionstarline.com
FROM_NAME=Orion Starline

# ========================================
# DEPLOYMENT CONFIGURATION
# ========================================
# Environment
ENVIRONMENT=development

# Application URL
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ========================================
# LOGGING & MONITORING
# ========================================
# Log Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Sentry DSN for error tracking
SENTRY_DSN=your-sentry-dsn-url

# ========================================
# FEATURE FLAGS
# ========================================
# Enable/disable features
ENABLE_AI_ASSISTANT=true
ENABLE_AUTO_TRADING=false
ENABLE_PREMIUM_FEATURES=true
ENABLE_EMAIL_VERIFICATION=true

# ========================================
# RATE LIMITING
# ========================================
# API Rate Limits
API_RATE_LIMIT_PER_MINUTE=100
API_RATE_LIMIT_PER_HOUR=1000

# Trading Rate Limits
TRADING_RATE_LIMIT_PER_MINUTE=10
TRADING_RATE_LIMIT_PER_HOUR=100

# ========================================
# BACKUP & STORAGE
# ========================================
# File Storage
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# Backup Settings
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30

# ========================================
# CRYPTO & TRADING
# ========================================
# Default Trading Settings
DEFAULT_TRADE_SIZE=0.01
DEFAULT_STOP_LOSS=2.0  # percentage
DEFAULT_TAKE_PROFIT=4.0  # percentage
MAX_LEVERAGE=10

# Risk Management
MAX_DAILY_RISK=5.0  # percentage of portfolio
MAX_POSITION_SIZE=10.0  # percentage of portfolio
MAX_OPEN_POSITIONS=10

# ========================================
# AI & ML CONFIGURATION
# ========================================
# AI Model Settings
AI_MODEL_CONFIDENCE_THRESHOLD=0.7
AI_PREDICTION_DAYS=7
AI_REFRESH_INTERVAL=3600  # seconds

# Machine Learning
ML_MODEL_PATH=./models
ML_TRAINING_DATA_PATH=./data/training
ML_BATCH_SIZE=32
ML_EPOCHS=100

# ========================================
# WEBSOCKET CONFIGURATION
# ========================================
# WebSocket Settings
WS_MAX_CONNECTIONS=1000
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10

# ========================================
# NOTIFICATION SETTINGS
# ========================================
# Push Notifications
PUSH_NOTIFICATION_KEY=your-firebase-key

# SMS Settings
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# ========================================
# TESTING CONFIGURATION
# ========================================
# Test Database
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/orion_starline_test

# Test Redis
TEST_REDIS_URL=redis://localhost:6379/1

# Test Mode
TESTING=false
# ========================================
# SECURITY SETTINGS
# ========================================
# Security Headers
SECURE_HEADERS=true

# Session Settings
SESSION_SECRET=your-session-secret-key
SESSION_EXPIRE_SECONDS=3600

# API Security
API_KEY_HEADER=X-API-Key
API_SECRET_HEADER=X-API-Secret

# ========================================
# PERFORMANCE SETTINGS
# ========================================
# Cache Settings
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Connection Pool
CONNECTION_POOL_MIN_SIZE=5
CONNECTION_POOL_MAX_SIZE=50

# ========================================
# DEVELOPMENT SETTINGS
# ========================================
# Debug Mode
DEBUG=false
VERBOSE=false

# Development Features
ENABLE_HOT_RELOAD=true
ENABLE_CORS=true
ENABLE_REQUEST_LOGGING=true

# ========================================
# PRODUCTION SETTINGS
# ========================================
# Production Flags
PROD=false
SSL_REQUIRED=true
FORCE_HTTPS=false

# CDN Settings
CDN_URL=https://cdn.orionstarline.com

# ========================================
# THIRD-PARTY INTEGRATIONS
# ========================================
# Trading Platforms
KUCOIN_API_KEY=your-kucoin-api-key
KUCOIN_SECRET_KEY=your-kucoin-secret-key

# Social Trading
GURU_API_KEY=your-guru-api-key
GURU_SECRET_KEY=your-guru-secret-key

# News APIs
NEWSAPI_KEY=your-newsapi-key
COINNEWS_API_KEY=your-coinnews-api-key

# ========================================
# MOBILE APP SETTINGS
# ========================================
# Firebase Configuration
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# ========================================
# ANALYTICS & TRACKING
# ========================================
# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X

# Mixpanel
MIXPANEL_TOKEN=your-mixpanel-token

# ========================================
# SUBSCRIPTION & BILLING
# ========================================
# Subscription Plans
STRIPE_PLAN_BASIC=price_basic_monthly
STRIPE_PLAN_PREMIUM=price_premium_monthly
STRIPE_PLAN_ENTERPRISE=price_enterprise_monthly

# Webhook URLs
STRIPE_WEBHOOK_URL=https://your-domain.com/api/webhooks/stripe
WEBHOOK_SECRET=your-webhook-secret

# ========================================
# END OF CONFIGURATION
# ========================================
# Note: This file contains template values.
# Copy this file to .env and replace with your actual values.
# Never commit .env files to version control!