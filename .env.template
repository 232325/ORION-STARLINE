# Orion Starline - Full-Stack Web Application
# Environment Configuration Template
# Copy this file to .env and update with your actual values

# ========================================================
# SUPABASE CONFIGURATION
# ========================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ========================================================
# DATABASE CONFIGURATION
# ========================================================
DATABASE_URL=postgresql://user:password@localhost:5432/orion_db
REDIS_URL=redis://localhost:6379

# ========================================================
# SECURITY CONFIGURATION
# ========================================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================================
# API KEYS FOR EXTERNAL SERVICES
# ========================================================
# Financial Data APIs
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
POLYGON_API_KEY=your-polygon-api-key
FINNHUB_API_KEY=your-finnhub-api-key

# News APIs
NEWS_API_KEY=your-news-api-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Voice/Audio APIs
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=your-azure-region
OPENAI_API_KEY=your-openai-api-key

# ========================================================
# APPLICATION CONFIGURATION
# ========================================================
ENVIRONMENT=development  # production, staging, development
DEBUG=True
LOG_LEVEL=INFO

# ========================================================
# STORAGE CONFIGURATION
# ========================================================
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,doc,docx,xlsx,csv

# ========================================================
# EMAIL CONFIGURATION
# ========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@orionstarline.com

# ========================================================
# CORS CONFIGURATION
# ========================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","https://yourdomain.com"]

# ========================================================
# MONITORING & LOGGING
# ========================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ELASTICSEARCH_URL=http://localhost:9200

# ========================================================
# TRADING CONFIGURATION
# ========================================================
TRADING_MODE=sandbox  # sandbox, paper, live
MAX_ORDER_SIZE=10000  # USD
MAX_DAILY_TRADES=100
RISK_LIMIT_PERCENTAGE=15

# ========================================================
# WALLET INTEGRATION
# ========================================================
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your-project-id
WEB3_TESTNET_URL=https://sepolia.infura.io/v3/your-project-id
ETHEREUM_PRIVATE_KEY=your-ethereum-private-key

# ========================================================
# NOTIFICATION SETTINGS
# ========================================================
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_SMS_NOTIFICATIONS=False
ENABLE_TELEGRAM_NOTIFICATIONS=True

# ========================================================
# PERFORMANCE SETTINGS
# ========================================================
MAX_WORKERS=4
DATABASE_POOL_SIZE=10
REDIS_TTL_SECONDS=3600
API_RATE_LIMIT=1000  # requests per hour

# ========================================================
# DEVELOPMENT SETTINGS
# ========================================================
AUTO_RELOAD=False
HOT_RELOAD=True
PROFILE_REQUESTS=False

# ========================================================
# PRODUCTION SETTINGS
# ========================================================
TRUST_PROXY_HEADERS=False
SECURE_COOKIES=True
SESSION_SECRET=your-session-secret-key

# ========================================================
# BACKUP CONFIGURATION
# ========================================================
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=orion-backups
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ========================================================
# COMPLIANCE & SECURITY
# ========================================================
ENABLE_AUDIT_LOGGING=True
AUDIT_LOG_RETENTION_DAYS=90
ENABLE_RATE_LIMITING=True
MAX_REQUESTS_PER_MINUTE=60

# ========================================================
# EXTERNAL INTEGRATIONS
# ========================================================
# Stripe Payment Integration
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# PayPal Integration
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Social Media Integration
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
LINKEDIN_CLIENT_ID=your-linkedin-client-id

# ========================================================
# AI/ML MODEL CONFIGURATION
# ========================================================
MODEL_CACHE_DIR=./models/cache
PREDICTION_MODEL_VERSION=1.0.0
SENTIMENT_MODEL_ENDPOINT=https://api.openai.com/v1
GPT_MODEL_VERSION=gpt-3.5-turbo