{
  "name": "smart-contract-deployment-testing",
  "version": "1.0.0",
  "description": "Smart Contract Deployment va Testing tizimi",
  "main": "index.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:unit": "hardhat test test/unit/",
    "test:integration": "hardhat test test/integration/",
    "test:e2e": "hardhat test test/e2e/",
    "test:performance": "hardhat test test/performance/",
    "test:load": "loadtest run test/load/load-test.js",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy.js --network testnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "deploy:verify": "hardhat verify --network mainnet",
    "coverage": "hardhat coverage",
    "lint": "solhint contracts/**/*.sol",
    "lint:fix": "prettier --write contracts/**/*.sol",
    "gas-report": "hardhat test test/gas/",
    "benchmark": "hardhat run scripts/benchmark.js",
    "monitor": "node scripts/monitor.js",
    "clean": "hardhat clean",
    "verify": "hardhat verify-contract"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.7",
    "@nomiclabs/hardhat-waffle": "^2.0.6",
    "@openzeppelin/contracts": "^5.0.0",
    "@openzeppelin/test-environment": "^2.0.0",
    "@openzeppelin/test-helpers": "^0.5.16",
    "@types/chai": "^4.3.10",
    "@types/mocha": "^10.0.6",
    "chai": "^4.3.10",
    "ethers": "^6.8.0",
    "hardhat": "^2.20.0",
    "hardhat-deploy": "^0.11.45",
    "hardhat-deploy-ethers": "^0.4.1",
    "hardhat-gas-reporter": "^1.0.9",
    "loadtest": "^5.2.0",
    "mocha": "^10.2.0",
    "prettier": "^3.0.3",
    "prettier-plugin-solidity": "^1.1.3",
    "solhint": "^4.0.0",
    "solidity-coverage": "^0.8.5",
    "truffle": "^5.11.4",
    "@truffle/hdwallet-provider": "^2.1.15",
    "web3": "^4.2.0"
  },
  "dependencies": {
    "@eth-optimism/sdk": "^3.2.0",
    "@maticnetwork/maticjs": "^3.6.5",
    "axios": "^1.5.0",
    "dotenv": "^16.3.1",
    "inquirer": "^8.2.6",
    "moment": "^2.29.4",
    "nodemailer": "^6.9.7",
    "prom-client": "^15.0.0",
    "winston": "^3.10.0"
  },
  "keywords": [
    "smart-contracts",
    "deployment",
    "testing",
    "hardhat",
    "truffle",
    "blockchain",
    "solidity"
  ]
}