# Environment Variables for Smart Contract Deployment

# Blockchain Network API Keys
ALCHEMY_API_KEY=your_alchemy_api_key_here
INFURA_API_KEY=your_infura_api_key_here

# Private Keys (NEVER commit these to git!)
PRIVATE_KEY=your_private_key_here
MNEMONIC=your_12_or_24_word_mnemonic_phrase_here

# Blockchain Explorer API Keys for Contract Verification
ETHERSCAN_API_KEY=your_etherscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/deployment_db
MONGODB_URL=mongodb://localhost:27017/smart_contracts

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_TO=admin@yourcompany.com

# Monitoring & Analytics
GRAFANA_URL=http://localhost:3000
GRAFANA_API_KEY=your_grafana_api_key
PROMETHEUS_URL=http://localhost:9090
ELASTICSEARCH_URL=http://localhost:9200

# External APIs
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
DEFI_PULSE_API_KEY=your_defipulse_api_key
THE_GRAPH_API_KEY=your_the_graph_api_key

# Security
ENCRYPTION_KEY=your_32_character_encryption_key
JWT_SECRET=your_jwt_secret_key

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/deployment.log
ERROR_NOTIFICATION_WEBHOOK=your_slack_webhook_url

# Performance & Load Testing
LOADTEST_URL=https://api.yourapp.com
LOADTEST_CONCURRENT_USERS=1000
LOADTEST_DURATION=60

# Deployment Configuration
DEPLOYMENT_ENV=development
AUTO_VERIFY_CONTRACTS=true
DEPLOYMENT_TIMEOUT=300000
MAX_GAS_PRICE=100_000_000_000

# CI/CD
GITHUB_TOKEN=your_github_token
DOCKER_REGISTRY=your_docker_registry
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# Smart Contract Specific
CONTRACT_OWNER_PRIVATE_KEY=owner_private_key
MULTISIG_ADDRESS=0x1234567890123456789012345678901234567890
PROXY_ADMIN_ADDRESS=0x1234567890123456789012345678901234567890

# Feature Flags
ENABLE_AUTOMATED_TESTING=true
ENABLE_SECURITY_SCANNING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_TRACKING=true

# Development
DEBUG=false
VERBOSE_LOGGING=false
COVERAGE_THRESHOLD=80