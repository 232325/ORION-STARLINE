# DAO Governance System - Environment Configuration

# Network RPC URLs
MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
GOERLI_RPC_URL=https://goerli.infura.io/v3/YOUR_INFURA_KEY
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

POLYGON_RPC_URL=https://polygon-rpc.com/
MUMBAI_RPC_URL=https://rpc-mumbai.matic.today

ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_TESTNET_RPC_URL=https://testnet.arbitrum.io/rpc

# Private Key (DO NOT SHARE THIS!)
# Generate new account and use for development only
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
POLYGONSCAN_API_KEY=your_polygonscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Gas Configuration
REPORT_GAS=true
GAS_PRICE_GWEI=20
GAS_MULTIPLIER=1.2

# Contract Verification
VERIFY_CONTRACTS=true
VERIFY_TIMEOUT=60000

# Database Configuration (for advanced features)
DATABASE_URL=postgresql://username:password@localhost:5432/dao_governance
REDIS_URL=redis://localhost:6379

# External Services
IPFS_GATEWAY=https://ipfs.io/ipfs/
IPFS_PINNING_SERVICE_API_KEY=your_ipfs_api_key
ORACLE_ADDRESS=0x...
CHAINLINK_API_KEY=your_chainlink_api_key

# Security Configuration
MNEMONIC=your_mnemonic_phrase_here
SECURITY_EMAIL=admin@yourdao.org
EMERGENCY_CONTACT=emergency@yourdao.org

# Monitoring and Analytics
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Feature Flags
ENABLE_MULTI_SIGNATURE=true
ENABLE_TIMELOCK=true
ENABLE_SNAPSHOT_VOTING=true
ENABLE_QUADRATIC_VOTING=true
ENABLE_DELEGATION=true
ENABLE_GRANTS=true
ENABLE_TREASURY=true
ENABLE_MEMBER_VERIFICATION=true

# Limits and Thresholds
MAX_PROPOSALS_PER_MEMBER=5
MAX_VOTING_POWER_PER_DELEGATION=1000
EMERGENCY_THRESHOLD_ETH=100
REQUIRED_SIGNATURES=3
QUORUM_PERCENTAGE=15
VOTING_PERIOD_DAYS=7
TIMELOCK_DELAY_HOURS=24

# Token Configuration
INITIAL_TOKEN_SUPPLY=1000000000
MIN_STAKING_AMOUNT=100
STAKING_REWARD_RATE=100
VOTING_POWER_MULTIPLIER_LOCK_30_DAYS=100
VOTING_POWER_MULTIPLIER_LOCK_90_DAYS=150
VOTING_POWER_MULTIPLIER_LOCK_180_DAYS=200
VOTING_POWER_MULTIPLIER_LOCK_365_DAYS=300
VOTING_POWER_MULTIPLIER_LOCK_730_DAYS=500

# Development Configuration
NODE_ENV=development
LOG_LEVEL=info
DEBUG_MODE=false
VERBOSE_LOGGING=false
CONSOLE_COLORS=true

# Testing Configuration
TEST_TIMEOUT_MS=30000
TEST_COVERAGE_ENABLED=true
FORK_MAINNET=false
FORK_BLOCK_NUMBER=latest