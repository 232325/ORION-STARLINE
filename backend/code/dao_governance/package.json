  "description": "Decentralized Autonomous Organization (DAO) Structure va Governance tizimi",
  "main": "hardhat.config.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:local": "hardhat run scripts/deploy-local.js --network localhost",
    "deploy:testnet": "hardhat run scripts/deploy-testnet.js --network testnet",
    "deploy:mainnet": "hardhat run scripts/deploy-mainnet.js --network mainnet",
    "deploy:all": "hardhat run scripts/deploy-all.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "test:unit": "hardhat test test/unit/",
    "test:integration": "hardhat test test/integration/",
    "test:e2e": "hardhat test test/e2e/",
    "coverage": "hardhat coverage",
    "gas-report": "hardhat test --gas-reports",
