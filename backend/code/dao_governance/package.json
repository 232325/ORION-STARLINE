    "blockchain",
    "smart-contracts",
    "decentralized",
    "voting",
    "treasury",
    "defi"
  ],
  "author": "DAO Governance Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomiclabs/hardhat-etherscan": "^3.1.8",
