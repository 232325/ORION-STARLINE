# AI Trading System - Environment Variables Example
# Copy this file to .env and modify the values

# Application Settings
DEBUG=True
SECRET_KEY=your-super-secret-key-change-in-production
PROJECT_NAME=AI Trading System API
VERSION=1.0.0
BASE_URL=http://localhost:8000

# Database Configuration
DATABASE_URL=sqlite:///./ai_trading.db
# For production, use:
# DATABASE_URL=postgresql://user:password@localhost/ai_trading

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0
# For production with password:
# REDIS_URL=redis://:password@localhost:6379/0

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080","https://aitrading.com"]

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
ALLOWED_FILE_EXTENSIONS=[".csv",".json",".xlsx",".txt",".pdf",".png",".jpg",".jpeg",".gif"]

# OAuth Configuration
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# External API Keys
# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Trading APIs
COINBASE_API_KEY=your-coinbase-api-key
COINBASE_API_SECRET=your-coinbase-api-secret
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret

# Quantum Computing
QUBITS_SIMULATOR_API=your-qubits-simulator-api
IBM_QUANTUM_API_KEY=your-ibm-quantum-api-key

# Blockchain
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your-project-id
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your-project-id
POLYGON_RPC_URL=https://polygon-rpc.com

# NFT Marketplaces
OPENSEA_API_KEY=your-opensea-api-key
RARIBLE_API_KEY=your-rarible-api-key

# SSL Certificates (for production)
SSL_CERT_PATH=/path/to/certificate.crt
SSL_KEY_PATH=/path/to/private.key

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@aitrading.com

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=True
ENABLE_SLACK_WEBHOOK=False
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Monitoring
ENABLE_METRICS=True
PROMETHEUS_PORT=9090

# Logging
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Performance
WORKERS=4
WORKER_CONNECTIONS=1000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Background Tasks
MAX_BACKGROUND_TASKS=50