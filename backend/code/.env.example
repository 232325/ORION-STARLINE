# =============================================================================
# AI Trading Evolution - Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values
# Author: MiniMax Agent
# Version: 1.0.0
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME="AI Trading Evolution"
APP_VERSION="1.0.0"
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=your-secret-key-here-change-this-in-production

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info
RELOAD=false

# -----------------------------------------------------------------------------
# CORS Settings
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_trading

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-here

# -----------------------------------------------------------------------------
# Stripe Payment Configuration
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Stripe Product/Price IDs
STRIPE_PRODUCT_BASIC=price_basic_plan_id
STRIPE_PRODUCT_PREMIUM=price_premium_plan_id
STRIPE_PRODUCT_ENTERPRISE=price_enterprise_plan_id

# -----------------------------------------------------------------------------
# Traditional Trading Platforms
# -----------------------------------------------------------------------------
# MetaTrader 5
MT5_LOGIN=your_mt5_login
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# Interactive Brokers
IB_GATEWAY_HOST=localhost
IB_GATEWAY_PORT=7497
IB_CLIENT_ID=1
IB_PAPER_TRADING=true

# Alpaca Markets
ALPACA_API_KEY=your_alpaca_api_key
ALPACA_SECRET_KEY=your_alpaca_secret_key
ALPACA_PAPER_TRADING=true

# -----------------------------------------------------------------------------
# Cryptocurrency Exchange API Keys
# -----------------------------------------------------------------------------
# Binance
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
BINANCE_SPOT_API_URL=https://api.binance.com
BINANCE_FUTURES_API_URL=https://fapi.binance.com

# Coinbase Pro
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_PASSPHRASE=your_coinbase_passphrase
COINBASE_SANDBOX=true

# Kraken
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# FTX (if available)
FTX_API_KEY=
FTX_API_SECRET=

# Bybit
BYBIT_API_KEY=your_bybit_api_key
BYBIT_SECRET_KEY=your_bybit_secret_key

# -----------------------------------------------------------------------------
# Market Data Providers
# -----------------------------------------------------------------------------
# Cryptocurrency Data
COINGECKO_API_KEY=
COINMARKETCAP_API_KEY=

# Stock Market Data
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
IEX_CLOUD_API_KEY=
TWELVE_DATA_API_KEY=

# Forex Data
FOREX_API_KEY=your_forex_api_key
CURRENCY_API_KEY=your_currency_api_key

# Metals Market Data
METALS_API_KEY=your_metals_api_key
METALS_API_URL=https://api.metals.live/v1
LME_API_KEY=your_lme_api_key

# Economic Data
FRED_API_KEY=your_fred_api_key
BLOOMBERG_API_KEY=your_bloomberg_api_key

# -----------------------------------------------------------------------------
# Social Media & News APIs
# -----------------------------------------------------------------------------
# Twitter/X
TWITTER_BEARER_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# News API
NEWS_API_KEY=

# -----------------------------------------------------------------------------
# AI/ML Services
# -----------------------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Hugging Face
HUGGINGFACE_API_KEY=

# -----------------------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------------------
# Sentry (error tracking)
SENTRY_DSN=

# Prometheus
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin
GRAFANA_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Nginx Configuration
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Email Configuration (for alerts)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Telegram Bot (for notifications)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# -----------------------------------------------------------------------------
# Trading Configuration
# -----------------------------------------------------------------------------
# Default trading parameters
DEFAULT_LEVERAGE=1
DEFAULT_STOP_LOSS_PERCENT=2.0
DEFAULT_TAKE_PROFIT_PERCENT=5.0
MAX_POSITION_SIZE=10000

# Risk Management
MAX_DAILY_LOSS=1000
MAX_DRAWDOWN_PERCENT=10.0

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
CACHE_TTL=300
CACHE_MAX_SIZE=1000

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
ENABLE_BACKTESTING=true
ENABLE_PAPER_TRADING=true
ENABLE_LIVE_TRADING=false
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_WHALE_TRACKING=true

# -----------------------------------------------------------------------------
# Blockchain & DeFi Configuration
# -----------------------------------------------------------------------------
# Ethereum/DeFi
ETH_RPC_URL=https://mainnet.infura.io/v3/your_project_id
ETH_TESTNET_RPC_URL=https://goerli.infura.io/v3/your_project_id
ETH_PRIVATE_KEY=your_ethereum_private_key

# Web3 Providers
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/your_project_id
WEB3_TESTNET_URL=https://goerli.infura.io/v3/your_project_id

# Oracle Services
CHAINLINK_API_KEY=your_chainlink_api_key
BAND_PROTOCOL_API_KEY=your_band_protocol_key

# NFT Marketplace APIs
OPENSEA_API_KEY=your_opensea_api_key
FOUNDATION_API_KEY=your_foundation_api_key
SUPERRARE_API_KEY=your_superrare_api_key
RARIBLE_API_KEY=your_rarible_api_key

# -----------------------------------------------------------------------------
# Quantum Computing Configuration
# -----------------------------------------------------------------------------
# IBM Quantum
IBM_QUANTUM_API_KEY=your_ibm_quantum_api_key
IBM_QUANTUM_HUB_ID=your_hub_id
IBM_QUANTUM_GROUP_ID=your_group_id
IBM_QUANTUM_PROJECT_ID=your_project_id

# Google Quantum AI
GOOGLE_QUANTUM_API_KEY=your_google_quantum_api_key

# Amazon Braket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# High Frequency Trading Configuration
# -----------------------------------------------------------------------------
# Low-latency settings
LOW_LATENCY_MODE=true
CO_LOCATION_ENABLED=true
NETWORK_INTERFACE=eth0

# Market Data Feeds
NASDAQ_FEED_URL=your_nasdaq_feed_url
NYSE_FEED_URL=your_nyse_feed_url

# Performance Optimization
MAX_MEMORY_USAGE=8GB
GC_THRESHOLD=700
MAX_CPU_CORES=8
THREAD_POOL_SIZE=16

# -----------------------------------------------------------------------------
# DAO Governance Configuration
# -----------------------------------------------------------------------------
# DAO Configuration
DAO_CONTRACT_ADDRESS=0x...
DAO_TOKEN_ADDRESS=0x...
GOVERNANCE_QUORUM=100000
GOVERNANCE_VOTING_PERIOD=3

# -----------------------------------------------------------------------------
# Storage & Backup Configuration
# -----------------------------------------------------------------------------
# AWS S3
AWS_S3_BUCKET=your-trading-data-bucket
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-west-2

# Google Cloud Storage
GCS_BUCKET=your-gcs-bucket
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# -----------------------------------------------------------------------------
# Risk Management & Compliance
# -----------------------------------------------------------------------------
# Risk Management
MAX_POSITION_SIZE=100000
MAX_DAILY_LOSS=10000
RISK_FREE_RATE=0.02
DEFAULT_RISK_LEVEL=moderate

# Compliance
COMPLIANCE_API_KEY=your_compliance_api_key
KYC_API_KEY=your_kyc_api_key

# Portfolio Management
DEFAULT_CURRENCY=USD
MAX_PORTFOLIO_DIVERSITY=20
AUTO_REBALANCE=false
REBALANCE_FREQUENCY=weekly

# -----------------------------------------------------------------------------
# Notification & Communication
# -----------------------------------------------------------------------------
# Slack Integration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Discord Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/DISCORD/WEBHOOK

# SMS Notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# -----------------------------------------------------------------------------
# Advanced Analytics & AI
# -----------------------------------------------------------------------------
# Model Storage
MODEL_STORAGE_PATH=/models
MODEL_REGISTRY_URL=http://localhost:8080

# TensorFlow/PyTorch
TORCH_HOME=/models/torch
TF_CPP_MIN_LOG_LEVEL=2

# Sentiment Analysis
SENTIMENT_API_KEY=your_sentiment_api_key

# -----------------------------------------------------------------------------
# Monitoring & Observability
# -----------------------------------------------------------------------------
# New Relic
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key

# Datadog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# Custom Settings
# -----------------------------------------------------------------------------
# Add your custom environment variables here

# =============================================================================
# Docker Compose Specific Configuration
# =============================================================================
# Database Configuration for Docker
POSTGRES_DB=trading_platform
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=secure_password_2025
POSTGRES_PORT=5432

# RabbitMQ Configuration for Docker
RABBITMQ_USER=trading_user
RABBITMQ_PASSWORD=rabbitmq_secure_password_2025
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Additional Redis Configuration
REDIS_PASSWORD=redis_secure_password_2025

# Additional Monitoring Ports
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
LOGSTASH_PORT=5044
LOGSTASH_MONITORING=9600
FLOWER_PORT=5555

# Flower Authentication
FLOWER_AUTH=admin:flower_admin_password_2025

# Internal Service URLs for Docker Networking
RABBITMQ_URL=amqp://trading_user:rabbitmq_secure_password_2025@rabbitmq:5672/

# =============================================================================
# Volume Mount Points (for bind mounts)
# =============================================================================
# Data directories will be created automatically in ./data/ subdirectory
# Log directories will be created automatically in ./logs/ subdirectory
