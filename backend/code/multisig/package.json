{
  "name": "multisig-wallet-integration",
  "version": "1.0.0",
  "description": "Keng qamrovli Multi-Signature Wallet Integration tizimi",
  "main": "index.js",
  "types": "index.ts",
  "files": [
    "*.js",
    "*.ts",
    "*.d.ts",
    "**/contracts/**",
    "**/core/**",
    "**/security/**",
    "**/governance/**",
    "**/interface/**",
    "**/key-management/**",
    "**/config/**"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "ts-node example_usage.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:contracts": "hardhat test",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "clean": "rimraf dist",
    "deploy": "hardhat run scripts/deploy.ts --network mainnet",
    "deploy:testnet": "hardhat run scripts/deploy.ts --network goerli",
    "verify": "hardhat verify --network mainnet CONTRACT_ADDRESS",
    "generate:docs": "typedoc",
    "prepare": "husky install",
    "precommit": "lint-staged"
  },
  "keywords": [
    "multisig",
    "wallet",
    "blockchain",
    "ethereum",
    "smart-contracts",
    "web3",
    "dao",
    "governance",
    "security",
    "gnosis-safe"
  ],
  "author": "MultiSig Wallet System Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/multisig-wallet-integration.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/multisig-wallet-integration/issues"
  },
  "homepage": "https://github.com/your-org/multisig-wallet-integration#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "ethers": "^6.0.0",
    "web3": "^4.0.0",
    "@gnosis.pm/safe-contracts": "^1.4.0",
    "@gnosis.pm/safe-core-sdk": "^3.0.0",
    "crypto": "^1.0.1",
    "node-forge": "^1.3.1",
    "argon2": "^0.31.0",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "@types/qrcode": "^1.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^1.0.9",
    "husky": "^8.0.3",
    "jest": "^29.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.71.0"
  },
  "optionalDependencies": {
    "@ledgerhq/hw-transport": "^6.28.0",
    "@trezor/hw-transport": "^1.0.0",
    "keep-key": "^1.0.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "testMatch": [
      "**/test/**/*.test.ts",
      "**/test/**/*.spec.ts"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!test/**",
      "!**/node_modules/**",
      "!**/dist/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  },
  "eslintConfig": {
    "parser": "@typescript-eslint/parser",
    "extends": [
      "eslint:recommended",
      "@typescript-eslint/recommended",
      "prettier"
    ],
    "plugins": [
      "@typescript-eslint",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": "error",
      "@typescript-eslint/no-explicit-any": "warn",
      "@typescript-eslint/no-unused-vars": "error"
    },
    "ignorePatterns": [
      "dist/",
      "node_modules/",
      "coverage/"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "tabWidth": 2,
    "trailingComma": "es5"
  }
}