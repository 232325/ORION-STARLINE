                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"strategy_name\": \"grid\",\n  \"symbol\": \"BTC/USDT\",\n  \"timeframe\": \"1h\",\n  \"parameters\": {\n    \"grid_levels\": 10,\n    \"price_range\": 0.05\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/strategy/execute",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "strategy", "execute"]
            },
            "description": "Execute grid trading strategy"
          }
        },
        {
          "name": "Execute Strategy - DCA",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"strategy_name\": \"dca\",\n  \"symbol\": \"BTC/USDT\",\n  \"timeframe\": \"1d\",\n  \"parameters\": {\n    \"investment_amount\": 100,\n    \"interval\": \"daily\"\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/strategy/execute",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "strategy", "execute"]
            },
            "description": "Execute DCA strategy"
          }
        },
        {
          "name": "Execute Strategy - Arbitrage",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"strategy_name\": \"arbitrage\",\n  \"symbol\": \"BTC/USDT\",\n  \"timeframe\": \"1m\",\n  \"parameters\": {\n    \"exchanges\": [\"binance\", \"coinbase\"],\n    \"min_profit\": 0.5\n  }\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/strategy/execute",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "strategy", "execute"]
            },
            "description": "Execute arbitrage strategy"
          }
        }
      ]
    },
