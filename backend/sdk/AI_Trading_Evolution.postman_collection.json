    {
      "name": "WebSocket",
      "description": "WebSocket information (not actual WS requests)",
      "item": [
        {
          "name": "WebSocket Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/ws/stats",
