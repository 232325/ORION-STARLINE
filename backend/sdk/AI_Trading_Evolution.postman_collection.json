{
  "info": {
    "name": "AI Trading Evolution API",
    "_postman_id": "ai-trading-evolution-v1",
    "description": "AI Trading Evolution REST API Collection\n\nOfficial Postman collection for AI Trading Evolution API with pre-configured requests and examples.\n\n**Base URL:** `http://localhost:8000`\n\n**Authentication:** Bearer Token (API Key)\n\n**Version:** 1.0.0\n\n**Author:** MiniMax Agent\n\n**Date:** 2025-11-04",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{API_KEY}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "API_KEY",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Core",
      "description": "Core API endpoints",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/",
              "host": ["{{BASE_URL}}"],
              "path": [""]
            },
            "description": "Root endpoint - API information"
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/health",
              "host": ["{{BASE_URL}}"],
              "path": ["health"]
            },
            "description": "Health check endpoint - returns service status and module health"
          }
        },
        {
          "name": "Metrics",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/metrics",
              "host": ["{{BASE_URL}}"],
              "path": ["metrics"]
            },
            "description": "Performance metrics endpoint"
          }
        }
      ]
    },
    {
      "name": "Market Data",
      "description": "Market data endpoints",
      "item": [
        {
          "name": "Get Market Data - BTC/USDT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"BTC/USDT\",\n  \"market_type\": \"crypto\",\n  \"timeframe\": \"1h\",\n  \"limit\": 100\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/market/data",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "market", "data"]
            },
            "description": "Get market data for BTC/USDT"
          }
        },
        {
          "name": "Get Market Data - ETH/USDT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"ETH/USDT\",\n  \"market_type\": \"crypto\",\n  \"timeframe\": \"1h\",\n  \"limit\": 100\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/market/data",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "market", "data"]
            },
            "description": "Get market data for ETH/USDT"
          }
        },
        {
          "name": "List Symbols - Crypto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/market/symbols?market_type=crypto",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "market", "symbols"],
              "query": [
                {
                  "key": "market_type",
                  "value": "crypto"
                }
              ]
            },
            "description": "Get list of crypto symbols"
          }
        },
        {
          "name": "List Symbols - Forex",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/market/symbols?market_type=forex",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "v1", "market", "symbols"],
              "query": [
                {
                  "key": "market_type",
                  "value": "forex"
                }
              ]
            },
            "description": "Get list of forex pairs"
          }
        }
      ]
    },
    {
      "name": "Trading Strategies",
      "description": "Trading strategy endpoints",
      "item": [
        {
          "name": "List Strategies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/strategy/list",
