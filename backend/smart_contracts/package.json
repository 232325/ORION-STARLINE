{
  "name": "trading-smart-contracts",
  "version": "1.0.0",
  "description": "Trading Smart Contracts - AI Trading, Portfolio Management, Risk Management, Settlement, Fee Management",
  "main": "index.js",
  "scripts": {
    "build": "hardhat compile",
    "clean": "hardhat clean",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "test:gas": "REPORT_GAS=true hardhat test",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "deploy:polygon": "hardhat run scripts/deploy.js --network polygon",
    "deploy:bsc": "hardhat run scripts/deploy.js --network bsc",
    "deploy:arbitrum": "hardhat run scripts/deploy.js --network arbitrum",
    "deploy:optimism": "hardhat run scripts/deploy.js --network optimism",
    "verify:local": "hardhat verify --network localhost DEPLOYED_CONTRACT_ADDRESS",
    "verify:sepolia": "hardhat verify --network sepolia DEPLOYED_CONTRACT_ADDRESS",
    "verify:mainnet": "hardhat verify --network mainnet DEPLOYED_CONTRACT_ADDRESS",
    "verify:polygon": "hardhat verify --network polygon DEPLOYED_CONTRACT_ADDRESS",
    "verify:bsc": "hardhat verify --network bsc DEPLOYED_CONTRACT_ADDRESS",
    "verify:arbitrum": "hardhat verify --network arbitrum DEPLOYED_CONTRACT_ADDRESS",
    "verify:optimism": "hardhat verify --network optimism DEPLOYED_CONTRACT_ADDRESS",
    "abi:export": "hardhat export-abi",
    "docs:generate": "hardhat dodoc",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write \"**/*.{js,ts,sol,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,ts,sol,json,md}\"",
    "security": "slither .",
    "gas-report": "hardhat test --reporter spec --grep \"should calculate gas cost\"",
    "benchmark": "hardhat test --grep \"benchmark\"",
    "precommit": "npm run format && npm run lint && npm run test",
    "prepare": "husky install"
  },
  "keywords": [
    "smart-contracts",
    "ethereum",
    "solidity",
    "trading",
    "ai",
    "portfolio",
    "risk-management",
    "defi",
    "blockchain",
    "ethers.js",
    "hardhat"
  ],
  "author": "Trading Smart Contracts Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.8",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomiclabs/hardhat-etherscan": "^3.1.7",
    "@openzeppelin/contracts": "^5.0.1",
    "@typechain/ethers-v5": "^11.1.2",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.9",
    "@types/mocha": "^10.0.4",
    "@types/node": "^20.8.7",
    "chai": "^4.3.10",
    "ethers": "^6.8.1",
    "hardhat": "^2.19.1",
    "hardhat-abi-exporter": "^2.10.1",
    "hardhat-gas-reporter": "^1.0.10",
    "husky": "^8.0.3",
    "prettier": "^3.0.3",
    "prettier-plugin-solidity": "^1.2.0",
    "solhint": "^4.1.1",
    "solhint-plugin-prettier": "^0.1.0",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.1",
    "typechain": "^8.3.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "@chainlink/contracts": "^0.8.0",
    "@openzeppelin/contracts-upgradeable": "^5.0.1",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.1",
    "web3": "^4.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/trading-smart-contracts.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/trading-smart-contracts/issues"
  },
  "homepage": "https://github.com/your-username/trading-smart-contracts#readme",
  "files": [
    "contracts/",
    "artifacts/",
    "cache/",
    "typechain/",
    "abi/",
    "docs/",
    "scripts/",
    "test/",
    "hardhat.config.js",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.{js,ts,sol}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ],
    "*.{json,md}": [
      "prettier --write",
      "git add"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}