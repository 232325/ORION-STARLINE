{
  "extends": "default",
  "rules": {
    "compiler-version": ["error", "^0.8.0"],
    "avoid-suicide": "error",
    "avoid-assert-supplemental-operand": "warn",
    "avoid-throw": "off",
    "avoid-tx-origin": "error",
    "avoid-tx-origin-global": "off",
    "check-send-result": "warn",
    "compiler-fixed": "off",
    "encode-override": "off",
    "external-function": "warn",
    "fixed": "off",
    "func-visibility": ["error", { "ignoreConstructors": true }],
    "imports-on-top": "error",
    "indentation": ["error", 4],
    "initialization": "off",
    "layer-zero-assign": "warn",
    "mark-callable-contracts": ["warn", { "internal": true, "custom": "false" }],
    "max-line-length": ["warn", 120],
    "max-states-count": ["warn", 15],
    "modifier-name-case": "error",
    "named-addresses": "off",
    "no-inline-assembly": "off",
    "no-simple-event-func-name": "off",
    "no-global-import": "off",
    "no-block-member-collision": ["warn"],
    "no-unused-import": "error",
    "no-unused-variable": ["error", { "ignoreVarsPattern": "^_*" }],
    "not-rely-on-chain-id": "warn",
    "not-rely-on-block-hash": "warn",
    "no-external-contract": "off",
    "no-complex-fallback": "warn",
    "no-protected": "off",
    "payable-fallback": "off",
    "private-vars-leading-underscore": "error",
    "quotes": ["error", "double"],
    "reentrancy": "warn",
    "ret-string": "warn",
    "rights-issue": "off",
    "self-construct": "warn",
    "separate-by-one-line-in-namespace": ["warn", "empty"],
    "solhint-disable-next-line": "warn",
    "solhint/enforce-internal-bounds": ["error"],
    "state-variables-consts": ["error", { "ignorePrivate": true }],
    "state-variable-shadowing": ["warn", { "oldStateVariable": true }],
    "todo-comments": "off",
    "uppercase": "warn",
    "var-name-mixedcase": ["error", { "allow": ["_before", "_after"] }],
    "visible": "off",
    "void-casting-operations": "warn",
    "while-used": "off",
    "with-pre功效混合": "off",
    "for-loop-overflows": ["warn"]
  }
}